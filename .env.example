# Copy this file to .env and fill in real values for local development.
# In production (Render), these are set as environment variables in the
# service dashboard / render.yaml — never commit a real .env file.

# --- Core Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
LOG_LEVEL=INFO
# Local dev only: set to True to enable django-debug-toolbar (config.settings.dev)
USE_DEBUG_TOOLBAR=False

# --- Database ---
# postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://mama_health:mama_health@localhost:5432/mama_health
DB_CONN_MAX_AGE=60

# --- Production-only security (config.settings.prod; safe defaults already
# apply even if unset — only override if Render's setup needs it) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000

# --- Redis (cache + Celery broker) — fully optional. Leave REDIS_URL blank
# to run with zero paid add-ons: cache falls back to local memory, and Celery
# tasks run inline (CELERY_TASK_ALWAYS_EAGER defaults to True) instead of
# going through a broker/worker. Set both once a real Celery worker exists.
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# --- Cron secret (production only) — required by /internal/tasks/<name>/,
# which a GitHub Actions scheduled workflow calls in place of a paid,
# always-on Celery Beat worker. Must match the CRON_SECRET repo secret in
# .github/workflows/scheduled-tasks.yml. Leave blank locally; the endpoint
# fails closed (403) when unset, so it's inert until you actually deploy.
CRON_SECRET=

# --- CORS (Flutter Web admin origin(s) once known; comma-separated) ---
CORS_ALLOWED_ORIGINS=

# --- JWT ---
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=14

# --- Email / SMTP (verification / password reset / doctor invite links) ---
# Switch EMAIL_BACKEND to the SMTP backend once real SMTP credentials are
# available; console backend just prints emails to the server log, useful
# for local dev / early deploys before the client hands over an SMTP account.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Mama Health <no-reply@mamahealth.app>
# Base URL used to build links inside emails (Flutter deep link host, or a
# minimal static confirmation page) since there is no server-rendered UI.
FRONTEND_URL=https://app.mamahealth.example

# --- Token / invite expiry windows (hours/days/minutes) ---
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=48
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=2
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
DOCTOR_INVITE_EXPIRY_DAYS=7

# --- AI Assistant (client-supplied later; leave blank to use the null/stub provider) ---
AI_PROVIDER=
AI_API_KEY=
AI_MODEL_NAME=

# --- WhatsApp Business API (client-supplied later) ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Firebase Cloud Messaging (client-supplied later; paste the full service-account JSON as one line) ---
FCM_CREDENTIALS_JSON=

# --- Google Places API (nearby hospitals; client-supplied later) ---
GOOGLE_PLACES_API_KEY=
HOSPITAL_CACHE_TTL_SECONDS=3600

# --- Admin account seeding (used by `python manage.py seed_admin`; never an HTTP endpoint) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
